services:
  api:
    build:
      context: .
      dockerfile: dockerfile  # Garanta que o nome do arquivo esteja correto
      target: final
    ports:
      - "8000:8000"
    env_file:
      - ./backend/.env.prod
    environment:
      - APP_ENV=prod
      - DATABASE_URL=postgresql://user:password@db:5432/dbname # Ajuste conforme seu .env
    restart: always
    depends_on:
      db:
        condition: service_healthy

  db:
    image: postgres:16-alpine
    container_name: devops-db-1
    env_file:
      - ./backend/.env.prod
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U $$POSTGRES_USER -d $$POSTGRES_DB"]
      interval: 5s
      timeout: 5s
      retries: 10
      start_period: 10s
    volumes:
      - postgres_prod_data:/var/lib/postgresql/data
    restart: always

volumes:
  postgres_prod_data: